<Window x:Class="AnnoPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="anno+ | Academic annotation studio" Height="820" Width="1320"
        MinHeight="620" MinWidth="900" Background="#F4F6FA" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#18253B" Padding="22,15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="anno+" FontSize="27" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="ACADEMIC ANNOTATION STUDIO" FontSize="10" FontWeight="SemiBold" Foreground="#AFC0E0" Margin="1,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open image" Click="OpenImage_Click" Padding="16,9" Margin="0,0,8,0"/>
                    <Button Content="Export PNG" Click="Export_Click" Padding="16,9" Background="#4778E8" Foreground="White" BorderBrush="#4778E8"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="ANNOTATION TOOLS" Foreground="#6D7890" FontSize="10" FontWeight="Bold" Margin="0,2,0,15"/>
                    <RadioButton x:Name="PenTool" Content="✎  Pen" IsChecked="True" GroupName="Tool" Checked="Tool_Checked" Margin="0,0,0,12" FontSize="14"/>
                    <RadioButton x:Name="HighlightTool" Content="▰  Highlighter" GroupName="Tool" Checked="Tool_Checked" Margin="0,0,0,12" FontSize="14"/>
                    <RadioButton x:Name="ArrowTool" Content="➜  Arrow" GroupName="Tool" Checked="Tool_Checked" Margin="0,0,0,12" FontSize="14"/>
                    <RadioButton x:Name="RectTool" Content="□  Rectangle" GroupName="Tool" Checked="Tool_Checked" Margin="0,0,0,12" FontSize="14"/>
                    <RadioButton x:Name="EllipseTool" Content="○  Ellipse" GroupName="Tool" Checked="Tool_Checked" Margin="0,0,0,20" FontSize="14"/>
                    <Separator Margin="0,0,0,15"/>
                    <TextBlock Text="INK COLOUR" Foreground="#6D7890" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                    <UniformGrid Columns="4" Rows="2" Margin="0,0,0,18">
                        <Button Background="#4778E8" Tag="#4778E8" Click="Color_Click" Margin="2" Height="27"/>
                        <Button Background="#E34B5B" Tag="#E34B5B" Click="Color_Click" Margin="2" Height="27"/>
                        <Button Background="#16A085" Tag="#16A085" Click="Color_Click" Margin="2" Height="27"/>
                        <Button Background="#F0B429" Tag="#F0B429" Click="Color_Click" Margin="2" Height="27"/>
                        <Button Background="#18253B" Tag="#18253B" Click="Color_Click" Margin="2" Height="27"/>
                        <Button Background="#8E5BD9" Tag="#8E5BD9" Click="Color_Click" Margin="2" Height="27"/>
                        <Button Background="#FFFFFF" Tag="#FFFFFF" Click="Color_Click" Margin="2" Height="27" BorderBrush="#D0D7E2"/>
                        <Button Background="#F58A36" Tag="#F58A36" Click="Color_Click" Margin="2" Height="27"/>
                    </UniformGrid>
                    <TextBlock Text="STROKE WIDTH" Foreground="#6D7890" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Slider x:Name="WidthSlider" Minimum="2" Maximum="16" Value="4" TickFrequency="2" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="UNDO / CLEAR" Foreground="#6D7890" FontSize="10" FontWeight="Bold" Margin="0,18,0,9"/>
                    <Button Content="Undo last" Click="Undo_Click" Padding="10,8" Margin="0,0,0,7"/>
                    <Button Content="Clear annotations" Click="Clear_Click" Padding="10,8"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#E9EDF4" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,12">
                        <TextBlock x:Name="DocumentLabel" Text="No document open" Foreground="#53617A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="CANVAS" Foreground="#8792A6" FontSize="10" FontWeight="Bold"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#D8DFEA" BorderThickness="1" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="DrawingCanvas" Background="White" Width="900" Height="620"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                    MouseMove="Canvas_MouseMove"
                                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" Margin="14,0,0,0">
                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#6D7890" FontSize="10" FontWeight="Bold" Margin="0,2,0,15"/>
                    <TextBlock Text="Document" FontWeight="SemiBold" Foreground="#18253B"/>
                    <TextBlock Text="Import an image to begin annotating lecture slides, diagrams, research figures, and study material." TextWrapping="Wrap" Foreground="#68758B" Margin="0,6,0,18" LineHeight="20"/>
                    <Separator/>
                    <TextBlock Text="Quick guide" FontWeight="SemiBold" Foreground="#18253B" Margin="0,16,0,8"/>
                    <TextBlock Text="1. Open an image\n2. Choose a tool and colour\n3. Draw directly on the canvas\n4. Export your annotated page as PNG" TextWrapping="Wrap" Foreground="#68758B" LineHeight="22"/>
                    <Border Background="#EEF3FF" CornerRadius="8" Padding="11" Margin="0,22,0,0">
                        <TextBlock Text="Tip: Use the highlighter for key evidence and the pen for detailed notes." TextWrapping="Wrap" Foreground="#3559A7" LineHeight="19"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
