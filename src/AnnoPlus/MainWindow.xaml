<Window x:Class="AnnoPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="anno+ | Visual study workspace" Height="900" Width="1500"
        MinHeight="650" MinWidth="1000" Background="#F3F5FA" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SnapsToDevicePixels="True" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#F7F9FC"/><Setter Property="BorderBrush" Value="#DCE2EC"/>
            <Setter Property="Foreground" Value="#26344D"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Padding" Value="8,9"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#34425B"/><Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17243A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#4778E8" Margin="0,0,12,0">
                        <Grid><TextBlock Text="a+" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <StackPanel><TextBlock Text="anno+" FontSize="25" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="YOUR VISUAL STUDY WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="#AFC0E0"/></StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="New workspace" Click="NewWorkspace_Click"/>
                    <Button Content="Add image" Click="OpenImage_Click"/>
                    <Button Content="Add text" Click="AddText_Click"/>
                    <Button Content="Stock images ↗" Click="StockImages_Click"/>
                    <Button Content="Save project" Click="SaveProject_Click"/>
                    <Button Content="Open project" Click="OpenProject_Click"/>
                    <Button Content="Export PNG" Click="Export_Click" Background="#4778E8" Foreground="White" BorderBrush="#4778E8" FontWeight="SemiBold"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E1E6EF" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="StatusLabel" Text="Ready · Drag image files into the workspace to add them" Foreground="#66748A" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="−" Click="ZoomOut_Click" Padding="10,3"/>
                    <Slider x:Name="ZoomSlider" Minimum="25" Maximum="200" Value="100" Width="140" VerticalAlignment="Center" ValueChanged="ZoomSlider_Changed"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Width="44" VerticalAlignment="Center" Foreground="#53617A"/>
                    <Button Content="+" Click="ZoomIn_Click" Padding="10,3"/>
                    <Button Content="Fit" Click="ZoomFit_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Margin="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="TOOLS" Foreground="#7B879A" FontSize="10" FontWeight="Bold" Margin="2,4,0,10"/>
                    <RadioButton x:Name="SelectTool" Content="↖  Select / move" GroupName="Tool" IsChecked="True" Checked="Tool_Checked"/>
                    <RadioButton x:Name="PenTool" Content="✎  Pen" GroupName="Tool" Checked="Tool_Checked"/>
                    <RadioButton x:Name="HighlightTool" Content="▰  Highlighter" GroupName="Tool" Checked="Tool_Checked"/>
                    <RadioButton x:Name="ArrowTool" Content="➜  Arrow" GroupName="Tool" Checked="Tool_Checked"/>
                    <RadioButton x:Name="RectTool" Content="□  Rectangle" GroupName="Tool" Checked="Tool_Checked"/>
                    <RadioButton x:Name="EllipseTool" Content="○  Ellipse" GroupName="Tool" Checked="Tool_Checked"/>
                    <RadioButton x:Name="TextTool" Content="T  Text" GroupName="Tool" Checked="Tool_Checked"/>
                    <Separator Margin="0,12"/>
                    <TextBlock Text="INK COLOUR" Foreground="#7B879A" FontSize="10" FontWeight="Bold" Margin="2,3,0,8"/>
                    <UniformGrid Columns="4" Rows="2" Margin="0,0,0,10">
                        <Button Background="#4778E8" Tag="#4778E8" Click="Color_Click" Height="27" Margin="2"/>
                        <Button Background="#E34B5B" Tag="#E34B5B" Click="Color_Click" Height="27" Margin="2"/>
                        <Button Background="#16A085" Tag="#16A085" Click="Color_Click" Height="27" Margin="2"/>
                        <Button Background="#F0B429" Tag="#F0B429" Click="Color_Click" Height="27" Margin="2"/>
                        <Button Background="#18253B" Tag="#18253B" Click="Color_Click" Height="27" Margin="2"/>
                        <Button Background="#8E5BD9" Tag="#8E5BD9" Click="Color_Click" Height="27" Margin="2"/>
                        <Button Background="#FFFFFF" Tag="#FFFFFF" Click="Color_Click" Height="27" Margin="2" BorderBrush="#D0D7E2"/>
                        <Button Background="#F58A36" Tag="#F58A36" Click="Color_Click" Height="27" Margin="2"/>
                    </UniformGrid>
                    <TextBlock Text="STROKE WIDTH" Foreground="#7B879A" FontSize="10" FontWeight="Bold" Margin="2,0,0,4"/>
                    <Slider x:Name="WidthSlider" Minimum="1" Maximum="18" Value="4" TickFrequency="1"/>
                    <Separator Margin="0,12"/>
                    <TextBlock Text="EDIT" Foreground="#7B879A" FontSize="10" FontWeight="Bold" Margin="2,0,0,8"/>
                    <Button Content="Copy  Ctrl+C" Click="Copy_Click"/>
                    <Button Content="Cut  Ctrl+X" Click="Cut_Click"/>
                    <Button Content="Paste  Ctrl+V" Click="Paste_Click"/>
                    <Button Content="Duplicate  Ctrl+D" Click="Duplicate_Click"/>
                    <Button Content="Delete  Del" Click="Delete_Click"/>
                    <Button Content="Undo  Ctrl+Z" Click="Undo_Click"/>
                    <Button Content="Clear workspace" Click="Clear_Click" Margin="2,8,2,2"/>
                </StackPanel></ScrollViewer>
            </Border>
            <Border Grid.Column="1" Background="#E8ECF3" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock x:Name="DocumentLabel" Text="Untitled workspace" Foreground="#46556D" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="INFINITE-STYLE CANVAS" Foreground="#8994A7" FontSize="9" FontWeight="Bold"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#F9FAFC" CornerRadius="8" BorderBrush="#D6DDE8" BorderThickness="1" ClipToBounds="True">
                        <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">
                            <Canvas x:Name="DrawingCanvas" Background="White" Width="1600" Height="1100"
                                    AllowDrop="True" Drop="Canvas_Drop" DragOver="Window_DragOver"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                    MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                <Canvas.LayoutTransform><ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
                            </Canvas>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="14" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="INSPECTOR" Foreground="#7B879A" FontSize="10" FontWeight="Bold" Margin="0,3,0,14"/>
                    <TextBlock Text="Selected object" FontWeight="SemiBold" Foreground="#1D2A40"/>
                    <TextBlock x:Name="SelectionLabel" Text="Nothing selected" Foreground="#68758B" Margin="0,5,0,16" TextWrapping="Wrap"/>
                    <Separator/>
                    <TextBlock Text="Workspace tips" FontWeight="SemiBold" Foreground="#1D2A40" Margin="0,15,0,8"/>
                    <TextBlock Text="• Add several images to build a board\n\n• Select and drag objects to arrange them\n\n• Ctrl + mouse wheel zooms in/out\n\n• Ctrl+C / X / V to copy, cut and paste\n\n• Save a project to keep editing later" TextWrapping="Wrap" Foreground="#68758B" LineHeight="19"/>
                    <Border Background="#EEF3FF" CornerRadius="8" Padding="10" Margin="0,18,0,0">
                        <TextBlock Text="Text is rendered with ClearType-style WPF font smoothing. Use the Text tool, then click the canvas to add a note." TextWrapping="Wrap" Foreground="#3559A7" LineHeight="18"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>